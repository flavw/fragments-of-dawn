static func initial_language(saved_language: String, device_locale: String) -> String:
	if saved_language in ["en", "pt", "es"]: return saved_language
	var device_language := device_locale.replace("-", "_").get_slice("_", 0).to_lower()
	return device_language if device_language in ["pt", "es"] else "en"

static func text(message: String, language: String) -> String:
	if language == "es":
		if message.begins_with("Art by "): return "Arte de " + message.trim_prefix("Art by ")
		return str(SPANISH.get(message, message))
	if language == "pt" and message.begins_with("Art by "):
		return "Arte por " + message.trim_prefix("Art by ")
	return str(PORTUGUESE.get(message, message)) if language == "pt" else message
